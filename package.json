{
  "name": "teacher-educational-app-clean-base",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "validate:content": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:run": "NODE_ENV=test vitest run",
    "security:scan": "node scripts/scan-secrets.mjs",
    "check": "npm run validate:content && npm run typecheck && npm run test:run && npm run security:scan",
    "build": "npm run check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
